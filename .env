# ─────────────────────────────────────────────
# FleetFlow — Variáveis de Ambiente (Backend)
# ─────────────────────────────────────────────

# Conexão com o banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root@localhost:3306/fleetflow"
# Porta do servidor (padrão: 5000)
PORT=5000

# Ambiente de execução
NODE_ENV=development

# JWT Secret — troque por uma string longa e aleatória antes de produção
JWT_SECRET=fleetflow_jwt_secret_troque_em_producao

# Expiração do token JWT
JWT_EXPIRES_IN=7d
